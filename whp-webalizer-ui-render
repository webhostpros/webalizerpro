#!/usr/bin/env python3
import glob
import os
import re
import time
from datetime import datetime
from html import unescape
from pathlib import Path

BACKUP_NAME = "index.webalizer.bak.html"
USAGE_RE = re.compile(r"usage_(\d{6})\.html$", re.IGNORECASE)


def is_webalizer_index(html: str) -> bool:
    return ("Generated by The Webalizer" in html) or ("Webalizer Version" in html)


def is_whp_index(html: str) -> bool:
    h = (html or "").lower()
    return ("webalizer pro" in h) and ("top entry pages" in h or "monthly reports" in h)


def strip_tags(s: str) -> str:
    out = re.sub(r"<script\b.*?</script>", " ", s or "", flags=re.IGNORECASE | re.DOTALL)
    out = re.sub(r"<style\b.*?</style>", " ", out, flags=re.IGNORECASE | re.DOTALL)
    out = re.sub(r"<.*?>", " ", out, flags=re.DOTALL)
    return " ".join(unescape(out).split()).strip()


def yyyymm_to_label(yyyymm: str) -> str:
    if not yyyymm or len(yyyymm) != 6 or not yyyymm.isdigit():
        return "—"
    y, m = int(yyyymm[:4]), int(yyyymm[4:6])
    months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    return f"{months[m - 1]} {y}" if 1 <= m <= 12 else yyyymm


def write_file_atomic(path: Path, content: str, uid: int, gid: int, mode: int = 0o644):
    tmp = path.with_suffix(path.suffix + f".tmp.{os.getpid()}")
    tmp.write_text(content, encoding="utf-8")
    os.chown(tmp, uid, gid)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def find_usage_files(d: Path):
    files = []
    try:
        for f in d.iterdir():
            if f.is_file() and USAGE_RE.match(f.name):
                files.append(f)
    except Exception:
        return []
    return sorted(files)


def find_latest_usage_html(d: Path):
    files = find_usage_files(d)
    if files:
        return files[-1]

    # fallback: derive candidates from any usage_YYYYMM links in known index files
    candidates = []
    for idx_name in ("index.html", BACKUP_NAME):
        ip = d / idx_name
        if not ip.exists():
            continue
        html = ip.read_text(errors="ignore")
        for yyyymm in re.findall(r"usage_(\d{6})\.html", html, re.IGNORECASE):
            candidates.append(yyyymm)
    if not candidates:
        return None

    yyyymm = sorted(set(candidates))[-1]
    rx = re.compile(rf"usage_{yyyymm}\.html$", re.IGNORECASE)
    for f in d.iterdir():
        if f.is_file() and rx.match(f.name):
            return f
    return None


def build_month_links_from_files(d: Path) -> str:
    files = sorted(find_usage_files(d), reverse=True)
    if not files:
        return "<p>No monthly reports found.</p>"
    items = []
    for f in files:
        m = USAGE_RE.search(f.name)
        yyyymm = m.group(1) if m else ""
        items.append(f'<li><a href="{f.name}" target="_blank" rel="noopener noreferrer">{yyyymm_to_label(yyyymm)}</a></li>')
    return "<ul class=\"months-grid\">" + "\n".join(items) + "</ul>"


def parse_current_row_from_index(index_html: str):
    m = re.search(r'<A HREF="usage_(\d{6})\.html".*?</A></TD>(.*?)</TR>', index_html, re.IGNORECASE | re.DOTALL)
    if not m:
        return {}
    yyyymm, row = m.group(1), m.group(2)
    nums = re.findall(r'ALIGN=right><FONT SIZE="-1">([^<]+)</FONT>', row, re.IGNORECASE)
    if len(nums) < 10:
        return {"yyyymm": yyyymm}

    def to_int(s):
        t = s.strip().replace(",", "")
        return int(t) if t.isdigit() else None

    return {"yyyymm": yyyymm, "monthly_sites": to_int(nums[4]), "monthly_visits": to_int(nums[6]), "monthly_hits": to_int(nums[9])}


def extract_domain_from_webalizer_source(html: str, fallback: str) -> str:
    m = re.search(r"<TITLE>\s*Usage Statistics for\s+(.+?)\s*-", html or "", re.IGNORECASE)
    if m:
        return strip_tags(m.group(1))
    pill = re.search(r'<span class="pill">(.*?)</span>', html or "", re.IGNORECASE | re.DOTALL)
    return strip_tags(pill.group(1)) if pill else fallback


def parse_tables(usage_html: str):
    tables = []
    for idx, t_html in enumerate(re.findall(r"<TABLE\b.*?</TABLE>", usage_html or "", re.IGNORECASE | re.DOTALL)):
        rows = []
        for tr in re.findall(r"<TR\b.*?>.*?</TR>", t_html, re.IGNORECASE | re.DOTALL):
            hs = [strip_tags(c) for c in re.findall(r"<TH\b.*?>\s*(.*?)\s*</TH>", tr, re.IGNORECASE | re.DOTALL)]
            cs = [strip_tags(c) for c in re.findall(r"<TD\b.*?>\s*(.*?)\s*</TD>", tr, re.IGNORECASE | re.DOTALL)]
            hs = [c for c in hs if c]
            cs = [c for c in cs if c]
            if hs and len(hs) >= len(cs):
                rows.append(("h", hs))
            elif cs:
                rows.append(("d", cs))
        if not rows:
            continue
        headers = [r for t, r in rows if t == "h"]
        tables.append({
            "index": idx,
            "header": max(headers, key=len) if headers else [],
            "data": [r for t, r in rows if t == "d"],
            "text": strip_tags(t_html).lower(),
        })
    return tables


def normalize_num(txt: str):
    t = (txt or "").strip().replace(",", "")
    return int(t) if t.isdigit() else None


def looks_like_referrer(s: str) -> bool:
    s = (s or "").strip()
    sl = s.lower()
    if (not s) or ("%" in s) or re.fullmatch(r"[\d\s.,%]+", s):
        return False
    if any(sl.startswith(p) for p in ("total ", "hits per", "files per", "sites per", "visits per", "kbytes per", "code ")):
        return False
    return sl.startswith(("http://", "https://")) or ("." in s and " " not in s)


def looks_like_page(s: str) -> bool:
    s = (s or "").strip().lower()
    if not s.startswith("/"):
        return False
    path = s.split("?", 1)[0].split("#", 1)[0]
    if path in {"/header.html", "/footer.html"}:
        return False
    if any(path.startswith(p) for p in ("/awstats", "/webalizer")):
        return False
    if path.endswith("/"):
        return True
    tail = path.rsplit("/", 1)[-1]
    if "." not in tail:
        return True
    ext = tail.rsplit(".", 1)[-1]
    return ext in {"php", "html", "htm", "asp", "aspx", "jsp", "cfm", "cgi", "pl", "shtml"}


def choose_label_column(table, kind: str):
    best_idx, best_score = None, -1
    max_cols = max((len(r) for r in table["data"]), default=0)
    for idx in range(min(12, max_cols)):
        score = 0
        for r in table["data"][:150]:
            if idx >= len(r):
                continue
            if kind == "ref" and looks_like_referrer(r[idx]):
                score += 1
            if kind in {"entry", "exit"} and looks_like_page(r[idx]):
                score += 1
        if score > best_score:
            best_idx, best_score = idx, score
    return best_idx, best_score


def choose_numeric_columns(table, label_idx: int):
    numeric = []
    max_cols = max((len(r) for r in table["data"]), default=0)
    for idx in range(min(12, max_cols)):
        if idx == label_idx:
            continue
        vals = [normalize_num(r[idx]) for r in table["data"] if idx < len(r)]
        vals = [v for v in vals if isinstance(v, int)]
        if len(vals) >= 3:
            numeric.append((idx, sum(vals) / len(vals)))
    if not numeric:
        return None, None

    header = [h.lower() for h in table["header"]]

    def by_header(tokens):
        for i, _ in numeric:
            if i < len(header) and any(t in header[i] for t in tokens):
                return i
        return None

    hits = by_header(["hits", "files"]) or max(numeric, key=lambda x: x[1])[0]
    visits = by_header(["visit"])
    if visits is None:
        for i, _ in sorted(numeric, key=lambda x: x[1], reverse=True):
            if i != hits:
                visits = i
                break
    return hits, visits


def table_bonus(table, kind: str):
    blob = (" ".join(table["header"]) + " " + table["text"]).lower()
    if kind == "ref":
        return 10 if any(k in blob for k in ("referrer", "referer")) else 0
    if kind == "exit":
        return 14 if "exit" in blob else -10
    if kind == "entry":
        b = 6 if any(k in blob for k in ("top pages", "top urls", "entry")) else 0
        if "exit" in blob:
            b -= 10
        return b
    if kind == "daily":
        return 10 if "daily" in blob else 0
    return 0


def extract_kind(table, kind: str, limit: int):
    if len(table["data"]) < 3:
        return [], -1, table["index"]
    label_idx, label_score = choose_label_column(table, kind)
    if label_idx is None or label_score < 3:
        return [], -1, table["index"]
    hits_idx, visits_idx = choose_numeric_columns(table, label_idx)
    if hits_idx is None:
        return [], -1, table["index"]

    out = []
    for r in table["data"]:
        if label_idx >= len(r):
            continue
        label = r[label_idx]
        if kind == "ref" and not looks_like_referrer(label):
            continue
        if kind in {"entry", "exit"} and not looks_like_page(label):
            continue
        out.append({
            "label": label,
            "hits": normalize_num(r[hits_idx]) if hits_idx < len(r) else None,
            "visits": normalize_num(r[visits_idx]) if visits_idx is not None and visits_idx < len(r) else None,
        })

    out.sort(key=lambda x: (x["hits"] is None, -(x["hits"] or 0), x["label"]))
    return out[:limit], label_score + table_bonus(table, kind), table["index"]


def extract_daily_metrics(usage_html: str):
    tables = parse_tables(usage_html)
    best = []
    for t in tables:
        blob = (" ".join(t["header"]) + " " + t["text"]).lower()
        if "daily" not in blob:
            continue
        max_cols = max((len(r) for r in t["data"]), default=0)
        if max_cols < 2:
            continue

        day_idx = visit_idx = site_idx = None
        for i in range(min(8, max_cols)):
            vals = [r[i].strip() for r in t["data"] if i < len(r)]
            if vals and sum(1 for v in vals if re.match(r"^\d{1,2}$|^\d{4}-\d{2}-\d{2}$", v)) >= 3:
                day_idx = i
                break

        header = [h.lower() for h in t["header"]]
        for i in range(min(8, max_cols)):
            if i < len(header) and "visit" in header[i]:
                visit_idx = i
            if i < len(header) and any(k in header[i] for k in ("site", "host")):
                site_idx = i

        if day_idx is None:
            continue
        if visit_idx is None:
            best_num = None
            for i in range(min(8, max_cols)):
                if i == day_idx:
                    continue
                vals = [normalize_num(r[i]) for r in t["data"] if i < len(r)]
                vals = [v for v in vals if isinstance(v, int)]
                if len(vals) >= 3:
                    avg = sum(vals) / len(vals)
                    if best_num is None or avg > best_num[1]:
                        best_num = (i, avg)
            visit_idx = best_num[0] if best_num else None
        if visit_idx is None:
            continue

        rows = []
        for r in t["data"]:
            if day_idx >= len(r) or visit_idx >= len(r):
                continue
            day = r[day_idx].strip()
            vis = normalize_num(r[visit_idx])
            if vis is None:
                continue
            sites = normalize_num(r[site_idx]) if site_idx is not None and site_idx < len(r) else None
            rows.append((day, vis, sites))
        if len(rows) > len(best):
            best = rows

    daily_visits = [v for _d, v, _s in best]
    site_values = [s for _d, _v, s in best if isinstance(s, int)]
    daily_avg_sites = round(sum(site_values) / len(site_values), 2) if site_values else None
    best_day_visits = max(daily_visits) if daily_visits else None

    # Fallback to summary rows like "Sites per Day" and "Visits per Day" (Avg/Max)
    if daily_avg_sites is None or best_day_visits is None:
        for t in tables:
            for r in t["data"]:
                cells = [c.strip() for c in r]
                if len(cells) < 3:
                    continue
                name = cells[0].lower()
                nums = [normalize_num(c) for c in cells[1:]]
                nums = [n for n in nums if isinstance(n, int)]
                if not nums:
                    continue
                if daily_avg_sites is None and "sites per day" in name:
                    daily_avg_sites = round(float(nums[0]), 2)
                if best_day_visits is None and "visits per day" in name:
                    best_day_visits = max(nums)
            if daily_avg_sites is not None and best_day_visits is not None:
                break

    return daily_visits, daily_avg_sites, best_day_visits


def extract_most_popular_hour(usage_html: str):
    tables = parse_tables(usage_html)
    best_hour = "—"
    best_val = -1
    for t in tables:
        blob = (" ".join(t["header"]) + " " + t["text"]).lower()
        if "hour" not in blob:
            continue
        max_cols = max((len(r) for r in t["data"]), default=0)
        if max_cols < 2:
            continue

        hour_idx = None
        for i in range(min(6, max_cols)):
            vals = [r[i].strip() for r in t["data"] if i < len(r)]
            if vals and sum(1 for v in vals if re.match(r"^\d{1,2}$", v)) >= 12:
                hour_idx = i
                break
        if hour_idx is None:
            continue

        hits_idx, visits_idx = choose_numeric_columns(t, hour_idx)
        metric_idx = visits_idx if visits_idx is not None else hits_idx
        if metric_idx is None:
            continue

        for r in t["data"]:
            if hour_idx >= len(r) or metric_idx >= len(r):
                continue
            hour = r[hour_idx].strip()
            val = normalize_num(r[metric_idx])
            if val is None:
                continue
            try:
                h = int(hour)
                label = f"{h:02d}:00"
            except Exception:
                label = hour
            if val > best_val:
                best_val = val
                best_hour = label
    return best_hour


def looks_like_url_label(s: str) -> bool:
    t = (s or "").strip()
    tl = t.lower()
    if not t or "%" in t or tl in {"url", "name", "total", "-"}:
        return False
    if t.startswith("/"):
        return True
    if re.search(r"[a-z]", tl) and ("." in t or "/" in t):
        return True
    return False


def extract_top_urls_by_kbytes(usage_html: str, limit: int = 10):
    tables = parse_tables(usage_html)
    best = []
    best_q = -1
    for t in tables:
        blob = (" ".join(t["header"]) + " " + t["text"]).lower()
        if "kbytes" not in blob:
            continue

        max_cols = max((len(r) for r in t["data"]), default=0)
        if max_cols < 2:
            continue

        header = [h.lower() for h in t["header"]]

        label_idx = None
        for i in range(min(12, max_cols)):
            if i < len(header) and any(k in header[i] for k in ("url", "page", "file", "name")):
                label_idx = i
                break

        if label_idx is None:
            best_label = None
            for i in range(min(12, max_cols)):
                vals = [r[i].strip() for r in t["data"] if i < len(r)]
                if not vals:
                    continue
                score = sum(1 for v in vals if looks_like_url_label(v)) - sum(1 for v in vals if "%" in v)
                if best_label is None or score > best_label[1]:
                    best_label = (i, score)
            label_idx = best_label[0] if best_label else None

        k_idx = None
        for i in range(min(12, max_cols)):
            if i < len(header) and "kbytes" in header[i]:
                k_idx = i
                break
        if k_idx is None:
            best_num = None
            for i in range(min(12, max_cols)):
                if i == label_idx:
                    continue
                vals = [normalize_num(r[i]) for r in t["data"] if i < len(r)]
                vals = [v for v in vals if isinstance(v, int)]
                if len(vals) >= 3:
                    avg = sum(vals) / len(vals)
                    if best_num is None or avg > best_num[1]:
                        best_num = (i, avg)
            k_idx = best_num[0] if best_num else None

        if label_idx is None or k_idx is None:
            continue

        items = []
        for r in t["data"]:
            if label_idx >= len(r) or k_idx >= len(r):
                continue
            label = (r[label_idx] or "").strip()
            if not looks_like_url_label(label):
                continue
            if label.startswith("/") and label.lower() in {"/header.html", "/footer.html"}:
                continue
            kb = normalize_num(r[k_idx])
            if kb is None:
                continue
            items.append({"label": label, "kbytes": kb})

        items.sort(key=lambda x: -x["kbytes"])
        q = (10 if "url" in blob or "page" in blob else 0) + (8 if "kbytes" in blob else 0) + len(items)
        if items and q > best_q:
            best, best_q = items[:limit], q

    # Raw HTML fallback for Webalizer variants that use TD-only header rows
    if best:
        return best

    for table_html in re.findall(r"<TABLE\b.*?</TABLE>", usage_html or "", re.IGNORECASE | re.DOTALL):
        plain = strip_tags(table_html).lower()
        if "kbytes" not in plain or ("url" not in plain and "urls by kbytes" not in plain):
            continue

        rows = []
        for tr in re.findall(r"<TR\b.*?>.*?</TR>", table_html, re.IGNORECASE | re.DOTALL):
            cols = [strip_tags(c) for c in re.findall(r"<TD\b.*?>\s*(.*?)\s*</TD>", tr, re.IGNORECASE | re.DOTALL)]
            cols = [c for c in cols if c]
            if cols:
                rows.append(cols)
        if len(rows) < 2:
            continue

        max_cols = max(len(r) for r in rows)
        url_idx = None
        for i in range(max_cols - 1, -1, -1):
            vals = [r[i] for r in rows if i < len(r)]
            score = sum(1 for v in vals if looks_like_url_label(v))
            if score >= 3:
                url_idx = i
                break

        k_idx = None
        best_avg = None
        for i in range(max_cols):
            if i == url_idx:
                continue
            vals = [normalize_num(r[i]) for r in rows if i < len(r)]
            vals = [v for v in vals if isinstance(v, int)]
            if len(vals) >= 3:
                avg = sum(vals) / len(vals)
                if best_avg is None or avg > best_avg:
                    best_avg = avg
                    k_idx = i

        if url_idx is None or k_idx is None:
            continue

        items = []
        for r in rows:
            if url_idx >= len(r) or k_idx >= len(r):
                continue
            label = r[url_idx].strip()
            if not looks_like_url_label(label):
                continue
            kb = normalize_num(r[k_idx])
            if kb is None:
                continue
            items.append({"label": label, "kbytes": kb})

        if items:
            items.sort(key=lambda x: -x["kbytes"])
            return items[:limit]

    return []


def normalize_host(value: str) -> str:
    s = re.sub(r"^https?://", "", (value or "").strip().lower())
    s = s.split("/", 1)[0].split(":", 1)[0]
    return s[4:] if s.startswith("www.") else s


def is_external_referrer(ref_label: str, domain: str) -> bool:
    ref = normalize_host(ref_label)
    base = normalize_host(domain)
    return not (ref and base and (ref == base or ref.endswith("." + base)))


def extract_sections(usage_html: str, domain: str, ref_limit: int = 200, entry_limit: int = 10, exit_limit: int = 10):
    tables = parse_tables(usage_html)
    c = {"ref": [], "entry": [], "exit": []}
    for t in tables:
        for kind in c:
            lim = ref_limit if kind == "ref" else (entry_limit if kind == "entry" else exit_limit)
            items, q, idx = extract_kind(t, kind, lim)
            if items:
                c[kind].append((q, idx, items))
    for k in c:
        c[k].sort(key=lambda x: x[0], reverse=True)

    def pick(kind, avoid=None):
        for _q, idx, items in c[kind]:
            if avoid is None or idx != avoid:
                return idx, items
        return None, []

    entry_idx, entry = pick("entry")
    _, exitp = pick("exit", avoid=entry_idx)
    if not exitp:
        _, exitp = pick("exit")
    _, refs = pick("ref")
    refs = [r for r in refs if is_external_referrer(r.get("label", ""), domain)]
    return {"referrers": refs[:ref_limit], "entry_pages": entry[:entry_limit], "exit_pages": exitp[:exit_limit]}


def render_collapsible_section(title: str, body_html: str, default_open: bool = False, help_text: str = ""):
    help_html = f" <span class='help' title=\"{help_text}\">?</span>" if help_text else ""
    return f'<details class="section collapsible"{" open" if default_open else ""}><summary>{title}{help_html}</summary><div class="section-body">{body_html}</div></details>'


def render_referrer_table(items):
    if not items:
        return render_collapsible_section("Top Referrers", '<div class="empty">No data found in the latest monthly report.</div>', help_text="External domains/URLs that sent traffic to your site.")
    rows = []
    for i in items:
        hits = f"{i['hits']:,}" if isinstance(i.get("hits"), int) else "—"
        rows.append(f"<tr><td>{i['label']}</td><td class='num'>{hits}</td></tr>")
    body = f"<div class='tablewrap'><table class='t'><thead><tr><th>Name</th><th class='num'>Hits</th></tr></thead><tbody>{''.join(rows)}</tbody></table></div>"
    return render_collapsible_section("Top Referrers", body, help_text="External domains/URLs that sent traffic to your site.")


def render_page_table(title: str, items):
    if not items:
        return render_collapsible_section(title, '<div class="empty">No data found in the latest monthly report.</div>', help_text=("First pages users landed on in visits." if "Entry" in title else "Pages users were on when their visit ended." if "Exit" in title else "URLs transferring the most bandwidth (KBytes)."))
    rows = []
    for i in items:
        hits = f"{i['hits']:,}" if isinstance(i.get("hits"), int) else "—"
        visits = f"{i['visits']:,}" if isinstance(i.get("visits"), int) else "—"
        rows.append(f"<tr><td>{i['label']}</td><td class='num'>{hits}</td><td class='num'>{visits}</td></tr>")
    body = f"<div class='tablewrap'><table class='t'><thead><tr><th>Name</th><th class='num'>Hits</th><th class='num'>Visits</th></tr></thead><tbody>{''.join(rows)}</tbody></table></div>"
    return render_collapsible_section(title, body, help_text=("First pages users landed on in visits." if "Entry" in title else "Pages users were on when their visit ended." if "Exit" in title else "URLs transferring the most bandwidth (KBytes)."))


def render_kbytes_table(title: str, items):
    if not items:
        return render_collapsible_section(title, '<div class="empty">No data found in the latest monthly report.</div>', help_text=("First pages users landed on in visits." if "Entry" in title else "Pages users were on when their visit ended." if "Exit" in title else "URLs transferring the most bandwidth (KBytes)."))
    rows = []
    for i in items:
        kb = f"{i['kbytes']:,}" if isinstance(i.get("kbytes"), int) else "—"
        rows.append(f"<tr><td>{i['label']}</td><td class='num'>{kb}</td></tr>")
    body = f"<div class='tablewrap'><table class='t'><thead><tr><th>Name</th><th class='num'>KBytes</th></tr></thead><tbody>{''.join(rows)}</tbody></table></div>"
    return render_collapsible_section(title, body, help_text=("First pages users landed on in visits." if "Entry" in title else "Pages users were on when their visit ended." if "Exit" in title else "URLs transferring the most bandwidth (KBytes)."))


def render_daily_graph(visits):
    if not visits:
        return ""
    w, h = 1100, 140
    max_v = max(visits) or 1
    step = w / max(1, len(visits) - 1)
    pts = [f"{round(i*step,2)},{round(h - (v/max_v)*(h-8)-4,2)}" for i, v in enumerate(visits)]
    return f"""<div class='trend'><svg viewBox='0 0 {w} {h}' preserveAspectRatio='none'><polyline points='{' '.join(pts)}' /></svg></div>"""


