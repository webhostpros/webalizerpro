def iter_webalizer_dirs():
    patterns = [
        "/home/*/tmp/webalizer/index.html",
        "/home/*/tmp/webalizer/*/index.html",
        "/home/*/tmp/webalizer/ssl/*/index.html",
    ]
    seen = set()
    for pat in patterns:
        for idx in glob.glob(pat):
            if idx.startswith("/home/virtfs/"):
                continue
            d = str(Path(idx).parent)
            if d not in seen:
                seen.add(d)
                yield Path(d)

    for usage in glob.glob("/home/*/tmp/webalizer/**/usage_*", recursive=True):
        if usage.startswith("/home/virtfs/"):
            continue
        up = Path(usage)
        if not up.is_file() or not USAGE_RE.match(up.name):
            continue
        d = str(up.parent)
        if d not in seen:
            seen.add(d)
            yield Path(d)


def main():
    changed = 0
    discovered = 0
    failed = 0
    samples = []
    for d in iter_webalizer_dirs():
        discovered += 1
        try:
            if process_dir(d):
                changed += 1
        except Exception as e:
            failed += 1
            if len(samples) < 5:
                samples.append(f"{d}: {e}")
            continue
    tail = f" (discovered {discovered} folders"
    if failed:
        tail += f", failed {failed}"
    tail += ")"
    print(f"whp-webalizer-ui-render: updated {changed} webalizer index pages{tail}")
    for line in samples:
        print(f"  error: {line}")


if __name__ == "__main__":
    main()
